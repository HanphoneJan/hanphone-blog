# JWT 密钥配置（必填）
# 未配置将拒绝启动。请修改为你自己的安全密钥，建议使用长字符串和特殊字符
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT 签发方（可选，默认 auth0）
# 改动会导致已签发的旧 token 全部失效，通常保持默认即可
# JWT_ISSUER=auth0

# 内部服务通信密钥（blog server 回收文件时使用，通过 x-internal-key 请求头认证）
# 与 server/.env 中的 INTERNAL_API_KEY 保持一致，留空则禁用内部认证
INTERNAL_API_KEY=your_internal_api_key_here

# 服务器端口配置（可选）
PORT=4000

# 对外文件域名（返回给前端的绝对 URL；默认 https://hanphone.top）
# 本地调试可设为 http://localhost:4000
PUBLIC_FILE_BASE_URL=https://hanphone.top

# ---------------------------------------------------------------------------
# 视频 HLS 转码（原片始终保留，派生资源在 uploads/.video/）
# ---------------------------------------------------------------------------
# 关闭后仍可上传/播放/下载原片，只是不生成 HLS
VIDEO_TRANSCODE_ENABLED=true
# 最高档位（短边）：1080 = 同时生成 1080/720（源片够大时），720 = 只生成 720
VIDEO_HLS_MAX_HEIGHT=1080
# HLS 分片长度（秒），建议 4
VIDEO_HLS_SEGMENT_SECONDS=4
# 同时转码的任务数；2C/2G 建议 1
VIDEO_TRANSCODE_CONCURRENCY=1
# ffmpeg 进程 nice 优先级（0-19，越大越让路）
VIDEO_TRANSCODE_NICE=10
# ffmpeg 线程数；2 核机器建议 2
VIDEO_FFMPEG_THREADS=2
# 单个任务超时（毫秒），默认 6 小时
VIDEO_TRANSCODE_TIMEOUT_MS=21600000
# 720p / 1080p 的峰值码率（kbps）
VIDEO_HLS_MAXRATE_720=3200
VIDEO_HLS_MAXRATE_1080=6000
VIDEO_HLS_AUDIO_BITRATE=128k
# 自定义二进制路径（默认走 PATH）
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
