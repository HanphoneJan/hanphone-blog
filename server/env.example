# Spring Profile: dev (开发环境) 或 prod (生产环境)
SPRING_PROFILES_ACTIVE=prod

# JWT 配置
TOKEN_SECRET=xxxxxx
JWT_ISSUER=auth0
JWT_EXPIRE_TIME=604800000

# 数据库配置
PG_HOST=localhost
PG_USERNAME=postgres
PG_PASSWORD=xxxxx

# 邮箱配置
EMAIL_FROM_NAME=xxxxx
EMAIL_USERNAME=xxxxx@163.com
EMAIL_PASSWORD=xxxxx
EMAIL_HOST=smtp.163.com

# Redis 配置
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=xxxxxx

# 服务器配置
SERVER_PORT=8090

# 内部服务通信密钥（hanphone-chat 调用 /api/** 接口时使用）
# 与 hanphone-chat server/.env 中的 BLOG_INTERNAL_KEY 保持一致
INTERNAL_API_KEY=your_internal_api_key_here

# 文件服务（admin-file）基础地址
# 用于删除随笔时回收 admin-file 中的物理文件，需与 admin-file 的对外地址一致
CORS_ALLOWED_ORIGINS=https://hanphone.cn,https://www.hanphone.cn,http://localhost:8080,http://localhost:3000,http://localhost:*,tauri://localhost

# GitHub OAuth 配置
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://hanphone.cn/api/oauth/github/callback
# Google OAuth 配置
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://hanphone.cn/api/oauth/google/callback
# Google OAuth 代理（国内服务器需配置，用于访问 oauth2.googleapis.com）
GOOGLE_OAUTH_PROXY_HOST=
GOOGLE_OAUTH_PROXY_PORT=0

# DB-IP City Lite mmdb 文件绝对路径（可选）
# 不配置时，后端自动加载当前工作目录下的 dbip-city-lite.mmdb（配合 scripts/update-dbip.sh 默认行为）
GEO_DB_PATH=

# ==================== 洞察（Insight）热点聚合 ====================
# 采集开关与 cron（默认每日 03:30）
HOT_COLLECT_ENABLED=true
HOT_COLLECT_CRON=0 30 3 * * *
# GitHub API Token（强烈建议配置，否则搜索接口配额很低）
GITHUB_TOKEN=
# Hugging Face Token（可选）
HUGGINGFACE_TOKEN=
# Hugging Face Hub 地址（国内服务器建议 https://hf-mirror.com）
HF_ENDPOINT=https://huggingface.co
# LMArena 数据集接口（datasets-server）；网络不可达时设为 false 关闭
LMARENA_ENDPOINT=https://datasets-server.huggingface.co
HOT_LMARENA_ENABLED=true
# Artificial Analysis 免费 API key（采集 LLM/图像/视频/语音竞技场榜单，可空）
AA_API_KEY=
# AI 中文摘要（OpenAI 兼容接口，如 DeepSeek / 通义 / OpenAI）；留空则关闭摘要功能
HOT_SUMMARY_BASE_URL=
HOT_SUMMARY_API_KEY=
HOT_SUMMARY_MODEL=
