# 桌面端（Tauri）静态导出构建的环境变量 —— 允许提交到仓库
#
# 用途：CI（GitHub Actions）里没有 .env（被 gitignore），导致 NEXT_PUBLIC_* 全部为空，
# 构建产物和本地不一致。build-tauri.mjs 会加载本文件作为兜底默认值，
# 真实环境变量 / .env 的优先级更高，不会被覆盖。
#
# ⚠️ 安全：这里只能放 NEXT_PUBLIC_* 这类会被内联进浏览器包、可公开访问的变量。
#    任何密钥（NETEASE_COOKIE_KEY、INTERNAL_API_KEY、LOCATION_KEY 等）都不要写进来。
#
# 下面的值均与线上生产环境 https://hanphone.cn 保持一致（已核对生产站点产物），
# 不要填 localhost / 127.0.0.1 / 测试域名。

# ===== 后端 API（生产） =====
NEXT_PUBLIC_API_BASE_URL=https://hanphone.cn/api
NEXT_PUBLIC_NEXT_API_BASE_URL=https://hanphone.cn/next-api

# ===== 站点（生产主域名，带 www 由 middleware 处理） =====
NEXT_PUBLIC_SITE_URL=https://hanphone.cn

# ===== 图片/文件服务（生产） =====
NEXT_PUBLIC_FILE_DOMAIN=hanphone.top
NEXT_PUBLIC_PICTURE_BASE_URL=https://hanphone.top

# ===== 页脚备案与联系方式（与线上保持一致） =====
NEXT_PUBLIC_FOOTER_QR_IMAGE=https://hanphone.top/images/云林有风公众号.jpg
NEXT_PUBLIC_FOOTER_EMAIL=janhizian@qq.com
NEXT_PUBLIC_FOOTER_GITHUB=https://github.com/HanphoneJan/
NEXT_PUBLIC_FOOTER_BILIBILI=https://space.bilibili.com/649062555/
NEXT_PUBLIC_FOOTER_ICP_URL=https://beian.miit.gov.cn/
NEXT_PUBLIC_FOOTER_ICP_NUMBER=粤ICP备2024325722号-2
NEXT_PUBLIC_FOOTER_PSB_URL=https://beian.mps.gov.cn/#/query/webSearch?code=44128302000378
NEXT_PUBLIC_FOOTER_PSB_NUMBER=粤公网安备44128302000378号

# ===== 其他功能开关（与生产一致） =====
# 站点起始运行时间，页脚运行时长展示
NEXT_PUBLIC_SITE_START_DATE=2025-01-01T00:00:00+08:00
# 移动端是否禁用 Live2D 看板娘（false = 移动端隐藏）
NEXT_PUBLIC_LIVE2D_MOBILE=false
# Google 登录 Web 客户端 ID（公开客户端 ID，非密钥）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=229616595720-9glch116n9rahtgmds4ol2gr1e85n74i.apps.googleusercontent.com