{
  "name": "chat-server",
  "version": "1.0.0",
  "description": "Real-time chat application server",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "start": "node --import dotenv/config dist/server.js",
    "dev": "tsx --import dotenv/config src/server.ts",
    "build": "tsc",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.8.0",
    "socket.io": "^4.7.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.6.6",
    "rimraf": "^5.0.1",
    "typescript": "^5.1.6"
  }
}
