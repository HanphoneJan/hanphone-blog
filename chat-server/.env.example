# ===== 服务端口 =====
PORT=4010

# ===== JWT 鉴权 =====
# 必填，必须与签发 token 的服务一致
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=auth0

# ===== 主数据库（聊天数据 chat_db） =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# ===== Blog Server 地址（用户中心 API，替代直连 blog 数据库） =====
BLOG_API_URL=http://localhost:8090
# 与 blog 后端 .env 的 INTERNAL_API_KEY 保持一致（chat↔blog 共享密钥）
BLOG_INTERNAL_KEY=your_internal_api_key_here

# ===== Agent Service 地址 =====
AGENT_SERVICE_URL=http://localhost:8001

# Server → Agent Service 通信密钥（共享密钥，两边保持一致）
# 不配置则不启用内部认证；生产环境强烈建议配置
INTERNAL_API_KEY=

# ===== FCM 推送（可选） =====
# Firebase 服务账号 JSON 的绝对路径；不配置则推送整体关闭（私信/热点更新）
# 私信：接收方无在线 socket 时才推；热点更新：blog 采集完成后经 /chat-api/internal/push 广播
FCM_SERVICE_ACCOUNT=/path/to/firebase-service-account.json
# 出网代理（国内服务器访问 Google 必须）：如 mihomo http://127.0.0.1:7890；留空则直连
FCM_PROXY=http://127.0.0.1:7890

# ===== AI 寒枫头像 URL（可选，不配置则不显示头像） =====
AI_AVATAR_URL=https://hanphone.cn/avatar.png

# ===== CORS 白名单（逗号分隔） =====
ALLOWED_ORIGINS=http://localhost:4010,http://localhost:4011,http://localhost:3000
