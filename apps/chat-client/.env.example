# Vite dev server 端口（vite.config 默认 4011）
VITE_PORT=4011

# ===== 生产构建（同源部署，构建期内联，改完必须重新 build）=====
# 聊天后端：同源相对路径，Nginx 反代 /chat-api → server:4010
VITE_API_BASE_URL=/chat-api
# 博客登录后端：浏览器可达的根地址，不要带 /api（客户端会拼 /api/login）
VITE_AUTH_BASE_URL=https://hanphone.cn
# Socket.IO：留空 = 与页面同源，自动连 /chat-api/socket.io
VITE_SOCKET_URL=

# ===== 本机开发（后端在 4010 / 8090）可临时覆盖 =====
# VITE_API_BASE_URL=http://localhost:4010/chat-api
# VITE_AUTH_BASE_URL=http://localhost:8090
# VITE_SOCKET_URL=http://localhost:4010
