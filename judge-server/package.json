{
  "name": "judge-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Python code judge for docs.hanphone.cn, backed by go-judge",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import dotenv/config dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "import:problems": "tsx src/import.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  }
}
