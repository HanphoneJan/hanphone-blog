# judge-server 本地开发默认值
PORT=5051

# PostgreSQL（judge 专用库，不要用博客库）
DATABASE_URL=postgres://judge:judge@127.0.0.1:5433/judge

# go-judge REST 地址（只监听 127.0.0.1）
GO_JUDGE_URL=http://127.0.0.1:5050
# go-judge -auth-token；留空表示本地未启用
GO_JUDGE_TOKEN=

# 管理端导入/统计令牌；生产必须改成随机值
ADMIN_TOKEN=dev-admin-token

# 允许的浏览器来源
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://docs.hanphone.cn

# 队列与限额
MAX_QUEUE=30
MAX_SOURCE_BYTES=65536
MAX_STDIN_BYTES=65536
MAX_OUTPUT_BYTES=65536
SUBMISSIONS_PER_MINUTE=3
SUBMISSIONS_PER_DAY=30
RUNS_PER_MINUTE=6

# 提交源码保留天数；0 表示只在内存中保留，落库时写空
SOURCE_RETENTION_DAYS=7

# 测试数据目录（相对 judge-server 或绝对路径）
DATA_DIR=./data/problems
