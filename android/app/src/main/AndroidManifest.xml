<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 聊天私信本地通知（Android 13+ 运行时请求） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 应用内更新：下载 APK 后安装（用户仍需在系统里确认安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 音乐库后台播放：前台服务（媒体播放类型）+ 息屏保持 CPU 唤醒 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BlogApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlogAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 第三方登录回跳：
                 1) App Links（首选，装 App 且 assetlinks.json 校验通过时由系统直接打开 App，不经过浏览器）
                    https://hanphone.cn/oauth/app/return?code=…
                 2) 自定义 scheme（兜底：App Links 未生效时，中转页里的按钮跳这里）
                 singleTop 保证从浏览器回来时复用当前实例，不叠第二层 MainActivity。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="hanphone.cn"
                    android:pathPrefix="/api/oauth/app/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hanphone" android:host="oauth" />
            </intent-filter>
            <!-- 站内深链（App Links）：博客/随笔/文库。解析规则见 util/DeepLink.kt。
                 多个 <data> 在同一 filter 内是「或」关系；autoVerify 复用域名级 assetlinks.json。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hanphone.cn" android:pathPrefix="/blog/" />
                <data android:scheme="https" android:host="hanphone.cn" android:pathPrefix="/essays" />
                <data android:scheme="https" android:host="hanphone.cn" android:pathPrefix="/docs" />
            </intent-filter>
            <!-- 音乐通知/锁屏点封面回到音乐库：hanphone://music（解析见 util/DeepLink.kt） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="hanphone" android:host="music" />
            </intent-filter>
        </activity>

        <!-- 应用内更新：把缓存里的 APK 通过 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 音乐库后台播放：Media3 前台服务（通知栏/锁屏/蓝牙耳机控制）。
             exported=true 是媒体按钮与外部控制器（车机/耳机）能连上的前提。 -->
        <service
            android:name=".playback.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- FCM 推送：前台/数据消息由 onMessageReceived 处理；后台通知消息由系统按默认渠道展示 -->
        <service
            android:name=".data.push.BlogMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chat_messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>

</manifest>